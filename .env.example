# Compose-level settings (read automatically from .env for interpolation).
# Production: copy to .env, then run compose with `-f compose.yaml` only.

# Public domain Caddy gets a certificate for. Not used by the local override.
SITE_ADDRESS=shop.example.com

# Pinned image tags pushed to GHCR (never `latest` in production).
API_IMAGE=ghcr.io/OWNER/store-backend:TAG
WEB_IMAGE=ghcr.io/OWNER/store-frontend:TAG

# Host port for the local override / dev profile.
HTTP_PORT=8080

# Checkout locations used by compose.dev.yaml (relative to this directory).
BACKEND_DIR=../store-backend
FRONTEND_DIR=../../Web/store-frontend
