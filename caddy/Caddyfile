# One public origin. SITE_ADDRESS is the domain in production (auto-TLS via
# Let's Encrypt) or ":80" for plain HTTP locally. Django is never exposed:
# the browser only talks to `web`, which proxies /api/** privately.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Product photos: originals have generated UUID names and derivatives are named by
	# content hash, so a URL's bytes never change. Only files that exist get the
	# one-year header; a 404 (a derivative still being processed) must not be cached.
	handle /media/* {
		root * /srv
		@exists file {
			try_files {path}
		}
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:3000 {
			lb_try_duration 2s
			transport http {
				dial_timeout 2s
			}
		}
	}

	# When `web` is down (502/503/504) show the maintenance page, with a 503.
	handle_errors {
		@web_down expression `{err.status_code} in [502, 503, 504]`
		handle @web_down {
			root * /srv/maintenance
			rewrite * /index.html
			header Cache-Control "no-store"
			header Retry-After "120"
			file_server {
				status 503
			}
		}
	}
}
