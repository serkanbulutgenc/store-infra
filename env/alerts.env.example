# Read by scripts/notify.sh and scripts/alerts-check.sh (not by any container).
# Push channel: an ntfy topic URL. Pick a long random topic name (it is the only secret),
# e.g. https://ntfy.sh/aura-store-<random>, and subscribe in the ntfy phone app.
NTFY_URL=
# Optional: also email each alert to this address. ntfy.sh no longer sends anonymous email, so
# the email goes straight to an SMTP relay (the shop's relay works). All four are needed.
ALERT_EMAIL=
# STARTTLS on 587 (smtp://) or implicit TLS on 465 (smtps://); TLS is always required.
ALERT_SMTP_URL=smtp://smtp.gmail.com:587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# Optional sender address; defaults to ALERT_SMTP_USER.
#ALERT_SMTP_FROM=
# Dead-man's switch for the whole stack: a healthchecks.io check (period 15 minutes, grace
# 20 minutes) pinged by alerts-check.sh only while api, web and caddy are healthy. If the
# server, Docker or the timer dies, the pings stop and the service alerts you. Use a second
# check, separate from PING_URL in backup.env.
HEARTBEAT_URL=
# Alert when the root disk is fuller than this percentage.
DISK_ALERT_PERCENT=80
