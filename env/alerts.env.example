# Read by scripts/notify.sh and scripts/alerts-check.sh (not by any container).
# Push channel: an ntfy topic URL. Pick a long random topic name (it is the only secret),
# e.g. https://ntfy.sh/aura-store-<random>, and subscribe in the ntfy phone app.
NTFY_URL=
# Optional: ntfy forwards each alert to this address as email too.
ALERT_EMAIL=
# Alert when the root disk is fuller than this percentage.
DISK_ALERT_PERCENT=80
