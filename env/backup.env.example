# Read by scripts/backup.sh, backup-check.sh and restore.sh (not by any container).
# rclone remote and path for the off-site bucket, configured with `rclone config` on the VPS.
RCLONE_REMOTE=offsite:store-backups
# PUBLIC age key (age1...). Backups are encrypted to it; the matching private key is
# kept off the VPS (password manager + printed copy) and is needed only to restore.
AGE_RECIPIENT=
# Optional dead-man's switch (e.g. healthchecks.io, grace 26h): pinged after each fully
# successful backup run, so a dead VPS or a stopped timer also raises the alert.
PING_URL=
