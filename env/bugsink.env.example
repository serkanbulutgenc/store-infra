# Self-hosted error tracker (service `bugsink`, profile `errors`). Real values live only in
# env/bugsink.env on the server (mode 600, never committed). See docs/runbook.md, "Error tracking".
PORT=8000
# At least 50 random characters. Replace with: openssl rand -hex 40
SECRET_KEY=CHANGE-SECRET-KEY
# First login, applied only while there are no users: email:password
CREATE_SUPERUSER=owner@example.com:CHANGE-ADMIN-PASSWORD
# The UI is reached through an SSH tunnel to 127.0.0.1:8000.
BASE_URL=http://localhost:8000
# Bugsink derives allowed hosts from BASE_URL; the apps call it by its service name.
ALLOWED_HOSTS=localhost,bugsink
# The `bugsink` role and database live in the store's Postgres (see the runbook).
DATABASE_URL=postgresql://bugsink:CHANGE-DB-PASSWORD@postgres:5432/bugsink
# Nobody can sign up; the Owner creates users.
USER_REGISTRATION=CB_NOBODY
# Do not contact bugsink.com. Check the startup log to confirm it is honoured.
PHONEHOME=False
# Optional: email alerts for new errors (reuse the shop's SMTP relay).
#EMAIL_HOST=
#EMAIL_PORT=587
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#DEFAULT_FROM_EMAIL=
