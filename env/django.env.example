# Backend (api, worker, beat). Real values live only in env/django.env on the
# server (mode 600, never committed). Generate secrets with: openssl rand -base64 48
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
DJANGO_ADMIN_URL=
# `api` is required: the web server calls http://api:5000 and Django checks Host.
DJANGO_ALLOWED_HOSTS=shop.example.com,api
# TLS ends at Caddy; Django trusts X-Forwarded-Proto and redirects nothing itself.
DJANGO_SECURE_SSL_REDIRECT=False
WEB_CONCURRENCY=3

# Error tracking (Sentry). Empty disables it. See docs/runbook.md, Monitoring and alerts.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

REDIS_URL=redis://redis:6379/0

# SMTP (see docs/runbook.md for SPF, DKIM and DMARC)
DJANGO_SERVER_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
