# Backend (api, worker, beat). Real values live only in env/django.env on the
# server (mode 600, never committed). Generate secrets with: openssl rand -base64 48
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
# `api` is required: the web server calls http://api:5000 and Django checks Host.
DJANGO_ALLOWED_HOSTS=shop.example.com,api
# The public storefront origin exactly as browsers send it in `Origin` (scheme and host, no slash).
# Django trusts only this for CSRF; it also builds the links in account emails.
DJANGO_FRONTEND_ORIGIN=https://shop.example.com
# TLS ends at Caddy; Django trusts X-Forwarded-Proto and redirects nothing itself.
DJANGO_SECURE_SSL_REDIRECT=False
WEB_CONCURRENCY=3

# Error tracking (self-hosted Bugsink via the Sentry SDK). Empty disables it.
# DSN looks like http://<key>@bugsink:8000/<project id>; see docs/runbook.md, "Error tracking (Bugsink)".
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

REDIS_URL=redis://redis:6379/0

# SMTP (see docs/runbook.md for SPF, DKIM and DMARC)
DJANGO_SERVER_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
