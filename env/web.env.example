# TanStack Start server. Both values are validated at startup.
API_INTERNAL_URL=http://api:5000
SESSION_COOKIE_NAME=store_session
# Must equal Django's CSRF_COOKIE_NAME (config.settings.production sets __Secure-csrftoken).
# If it differs, the proxy cannot find the cookie and a first-time guest's basket add gets 403.
CSRF_COOKIE_NAME=__Secure-csrftoken

# Error tracking for the Start server (optional; same Sentry project or a second one).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
